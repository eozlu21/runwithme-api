{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "High-level classification such as info, warning, error."
    },
    "data": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Human-readable summary that Gemini produces for the user."
        },
        "highlights": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional bullet-style facts extracted from the API response."
        },
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["key", "value"]
          },
          "description": "Optional list of key/value facts for extra context."
        }
      },
      "required": ["summary"]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "string" }
        },
        "required": ["code", "message"]
      }
    }
  },
  "required": ["type", "data", "errors"]
}
